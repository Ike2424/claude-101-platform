# ============================================================
# Claude 101 Platform — Variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# Nunca subas .env a git (ya está en .gitignore).
# ============================================================

# --- Servidor ---
PORT=3000
PUBLIC_URL=http://localhost:3000

# --- Auth ---
# Genera un secreto fuerte: openssl rand -hex 32
JWT_SECRET=change_me
# Vida del token de sesión tras hacer login (formato zeit/ms o segundos)
SESSION_LIFETIME=180d
# Vida del magic link
MAGIC_LINK_LIFETIME_MIN=20

# --- Base de datos ---
# sqlite (por defecto) | postgres
DB_DRIVER=sqlite
# Solo si DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Stripe ---
# Obtener en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Después de configurar el webhook (ver SETUP.md), pega aquí el signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Precio en céntimos (4900 = 49,00 €)
COURSE_PRICE_CENTS=4900
COURSE_CURRENCY=eur
COURSE_NAME=Claude 101 — Acceso vitalicio

# --- Email ---
# Provider: resend (recomendado) | smtp | console (solo dev, imprime el link en consola)
MAIL_PROVIDER=resend
# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxx
MAIL_FROM="Claude 101 <hola@tudominio.com>"
# Solo si MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Producto ---
COURSE_PUBLIC_NAME=Claude 101
COURSE_TAGLINE=Aprende a trabajar con Claude desde cero
SUPPORT_EMAIL=hola@claude101.com
COMPANY_NAME=Claude 101
COMMUNITY_URL=https://discord.gg/tu-discord-aqui

# --- Admin ---
# Token largo y aleatorio. Lo pides al entrar a /admin. Cambialo. openssl rand -hex 32
ADMIN_TOKEN=change_me

# --- Subdominios (opcional para producción) ---
# Si configuras DNS de los subdominios → tu IP, el middleware vhost los mapea solo.
# Ejemplo: app.tudominio.com → /app, blog.tudominio.com → /blog
ENABLE_VHOST=false
ROOT_DOMAIN=tudominio.com

# --- Google OAuth (opcional, para login con Google) ---
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
# 4. Pega aquí el client_id y secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sentry (opcional, monitoring de errores) ---
# Obtén DSN en https://sentry.io → tu proyecto → Settings → Client Keys
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE_VERSION=claude-101@1.0.0

# --- Tuning Postgres (opcional) ---
PG_POOL_MAX=10
DB_SLOW_QUERY_MS=200
RATE_LIMIT_PER_MIN=120
LOG_LEVEL=info
