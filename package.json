{
  "name": "claude-101-platform",
  "version": "1.0.0",
  "description": "Claude 101 — curso con landing pública, autenticación por magic link y paywall con Stripe.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "setup-demo": "node scripts/setup-demo.js",
    "check:prod": "node scripts/production-check.js",
    "healthcheck": "node scripts/healthcheck.js",
    "migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.js",
    "backup:pg": "bash scripts/backup-pg.sh",
    "restore:pg": "bash scripts/restore-pg.sh",
    "postinstall": "node -e \"console.log('Claude101: postinstall OK')\"",
    "tunnel": "echo '\\n→ Asegúrate de tener cloudflared instalado: brew install cloudflared\\n→ Tu servidor en localhost:3000 será público en una URL trycloudflare.com\\n' && cloudflared tunnel --url http://localhost:3000"
  },
  "engines": {
    "node": ">=20.10.0 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.7",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^4.8.0",
    "stripe": "^17.7.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^8.45.0",
    "pg": "^8.13.1",
    "pino-pretty": "^11.3.0"
  }
}
